APP_HOST=0.0.0.0
APP_PORT=8082
APP_BASE_URL=http://localhost:8082
# Isi jika aplikasi dipublish di sub-path reverse proxy, contoh: /resida
APP_PUBLIC_PATH=
# IP reverse proxy yang dipercaya untuk header X-Forwarded-*. Default aman untuk reverse proxy lokal.
FORWARDED_ALLOW_IPS=127.0.0.1
ENVIRONMENT=production
AUTO_CREATE_TABLES=false
SEED_ON_STARTUP=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_resida
DB_USER=resida_app
DB_PASSWORD=resida_password

JWT_SECRET_KEY=change-this-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=43200

SMTP_HOST=mail.frontierid.com
SMTP_PORT=587
SMTP_USER=bimasena_noreply@frontierid.com
SMTP_PASSWORD=Sentul#2025
SMTP_FROM=noreply@resida.local

# Physical folder for uploaded files. Use a path writable by the service user.
# Linux example: /var/lib/resida/uploads
# Windows example: D:/resida/uploads
UPLOAD_DIR=uploads

# Public URL prefix served by the app for uploaded files.
UPLOAD_URL_PREFIX=/uploads

SEED_SUPERADMIN_EMAIL=superadmin@resida.local
SEED_SUPERADMIN_PASSWORD=Resida123!
